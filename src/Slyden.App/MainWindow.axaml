<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Slyden.App"
        x:Class="Slyden.App.MainWindow"
        Title="Slyden" Width="1280" Height="800" MinWidth="980" MinHeight="640" WindowState="Maximized">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- topo -->
    <Border Grid.Row="0" Background="#1F1F22" BorderBrush="#333338" BorderThickness="0,0,0,1" Height="40">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="8" Height="8" CornerRadius="2" Background="#3B8BFF" VerticalAlignment="Center" />
          <TextBlock Text="SLYDEN" FontWeight="Medium" LetterSpacing="2" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
          <Border Width="1" Height="18" Background="#333338" VerticalAlignment="Center" Margin="0,0,6,0" />
          <Menu x:Name="MainMenu" VerticalAlignment="Center" Height="30">
            <MenuItem Header="_Arquivo" x:Name="MenuFile">
              <MenuItem x:Name="MenuNew" Header="_Novo projeto…" />
              <MenuItem x:Name="MenuProjects" Header="_Projetos" />
              <Separator />
              <MenuItem x:Name="MenuSave" Header="_Salvar" InputGesture="Ctrl+S" />
              <MenuItem x:Name="MenuExport" Header="_Exportar vídeo…" />
              <Separator />
              <MenuItem x:Name="MenuExit" Header="S_air" />
            </MenuItem>
            <MenuItem Header="_Editar" x:Name="MenuEdit">
              <MenuItem x:Name="MenuUndo" Header="_Desfazer" InputGesture="Ctrl+Z" />
              <MenuItem x:Name="MenuRedo" Header="_Refazer" InputGesture="Ctrl+Y" />
            </MenuItem>
            <MenuItem Header="_Projeto" x:Name="MenuProject">
              <MenuItem x:Name="MenuMusic" Header="Escolher _música…" />
              <MenuItem x:Name="MenuRemoveMusic" Header="_Remover música" />
              <Separator />
              <MenuItem x:Name="MenuSettings" Header="_Configurações e presets…" />
            </MenuItem>
            <MenuItem Header="A_juda" x:Name="MenuHelp">
              <MenuItem x:Name="MenuShortcuts" Header="_Atalhos de teclado" />
              <MenuItem x:Name="MenuAbout" Header="_Sobre o Slyden" />
            </MenuItem>
          </Menu>
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="ProjectName" Classes="dim" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Text="Nenhum projeto aberto" />
        <StackPanel Grid.Column="2" x:Name="EditorActions" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="SaveState" Classes="hint" VerticalAlignment="Center" />
          <Button x:Name="UndoButton" Classes="btn" Content="↶ Desfazer" IsEnabled="False" ToolTip.Tip="Desfazer (Ctrl+Z)" />
          <Button x:Name="RedoButton" Classes="btn" Content="↷ Refazer" IsEnabled="False" ToolTip.Tip="Refazer (Ctrl+Y)" />
          <Button x:Name="SaveButton" Classes="btn" Content="Salvar" />
          <Button x:Name="RemoveMusicButton" Classes="btn" Content="Remover música" IsVisible="False" />
          <Button x:Name="ExportButton" Classes="btn primary" Content="Exportar" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- meio -->
    <Grid Grid.Row="1" ColumnDefinitions="*,320">

      <!-- palco -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" BorderBrush="#333338" BorderThickness="0,0,0,1" Padding="12,8">
          <Grid ColumnDefinitions="Auto,*">
            <Border BorderBrush="#44444A" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
              <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="Fmt169" Classes="seg" Content="16:9" IsChecked="True" />
                <ToggleButton x:Name="Fmt916" Classes="seg" Content="9:16" />
                <ToggleButton x:Name="Fmt11" Classes="seg" Content="1:1" />
              </StackPanel>
            </Border>
            <TextBlock Grid.Column="1" x:Name="SlideInfo" Classes="hint" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Text="Abra uma pasta com fotos para começar" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="#0F0F11" Padding="20">
          <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- moldura tracejada no texto selecionado -->
            <Rectangle x:Name="TextSelection" Stroke="#3B8BFF" StrokeThickness="1.5" StrokeDashArray="4,3"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="False" />
            <!-- camada transparente que recebe o arrastar do texto -->
            <Border x:Name="PreviewHit" Background="Transparent" />
            <TextBlock x:Name="EmptyHint" Classes="hint" Text="A prévia aparece aqui."
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#333338" BorderThickness="0,1,0,0" Padding="12,8">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
            <Button x:Name="PlayButton" Classes="btn" Content="▶  Reproduzir" MinWidth="120"
                    ToolTip.Tip="Toca o slideshow a partir da foto selecionada, com a música (atalho: Espaço)" />
            <TextBlock Grid.Column="1" x:Name="PlayTime" Classes="dim" VerticalAlignment="Center" MinWidth="90" Text="" />
            <TextBlock Grid.Column="2" Classes="dim" VerticalAlignment="Center" Text="Movimento" />
            <Slider Grid.Column="3" x:Name="MotionSlider" Minimum="0" Maximum="1" Value="0.5" />
            <TextBlock Grid.Column="4" x:Name="RhythmInfo" Classes="hint" VerticalAlignment="Center" Text="" />
          </Grid>
        </Border>
      </Grid>

      <!-- painel -->
      <Border Grid.Column="1" Background="#1F1F22" BorderBrush="#333338" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Border BorderBrush="#333338" BorderThickness="0,0,0,1">
            <UniformGrid Rows="1">
              <ToggleButton x:Name="TabSlide" Classes="tab" Content="Slide" IsChecked="True" />
              <ToggleButton x:Name="TabText" Classes="tab" Content="Texto" />
              <ToggleButton x:Name="TabDefault" Classes="tab" Content="Padrão" />
              <ToggleButton x:Name="TabExport" Classes="tab" Content="Exportar" />
            </UniformGrid>
          </Border>

          <ScrollViewer Grid.Row="1">
            <Panel Margin="14">

              <!-- aba Slide -->
              <StackPanel x:Name="PaneSlide" Spacing="12">
                <TextBlock Classes="h" Text="MOVIMENTO" />
                <WrapPanel x:Name="EffectChips" />
                <Grid ColumnDefinitions="*,150">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Intensidade" />
                  <Slider Grid.Column="1" x:Name="IntensitySlider" Minimum="1" Maximum="30" Value="15" />
                </Grid>
                <TextBlock Classes="h" Text="TRANSIÇÃO AO ENTRAR" />
                <WrapPanel x:Name="TransitionChips" />
                <TextBlock Classes="h" Text="DURAÇÃO E FOTO" />
                <Grid ColumnDefinitions="*,90">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Ciclos de batida" />
                  <ComboBox Grid.Column="1" x:Name="LengthBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem>1</ComboBoxItem><ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem><ComboBoxItem>4</ComboBoxItem>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,150">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Escurecer foto" />
                  <Slider Grid.Column="1" x:Name="DimSlider" Minimum="0" Maximum="100" Value="0" />
                </Grid>
                <TextBlock Classes="h" Text="TAMANHO DA FOTO E FUNDO" />
                <Grid ColumnDefinitions="*,40,120">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Tamanho da foto" />
                  <TextBlock Grid.Column="1" x:Name="ScaleValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" Text="100%" />
                  <Slider Grid.Column="2" x:Name="ScaleSlider" Minimum="30" Maximum="100" Value="100" />
                </Grid>
                <WrapPanel x:Name="BackgroundChips" />
                <Button x:Name="ResetSlideButton" Classes="btn" Content="Voltar ao padrão" HorizontalAlignment="Left" />
                <TextBlock Classes="h" Text="CAPA" />
                <Button x:Name="CoverButton" Classes="btn" Content="Criar capa nesta foto" HorizontalAlignment="Left" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="Dura 2 ciclos, escurece a foto e adiciona título, nomes e data. Edite os textos na aba Texto." />
              </StackPanel>

              <!-- aba Texto -->
              <StackPanel x:Name="PaneText" Spacing="10" IsVisible="False">
                <TextBlock Classes="h" Text="TEXTOS NESTE SLIDE" />
                <ListBox x:Name="TextList" MaxHeight="130">
                  <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="AddTextButton" Classes="btn" Content="+ Adicionar texto" />
                  <Button x:Name="RemoveTextButton" Classes="btn" Content="Remover" />
                </StackPanel>
                <StackPanel x:Name="TextEditor" Spacing="10">
                  <TextBlock Classes="h" Text="TEXTO SELECIONADO" />
                  <TextBox x:Name="TextContent" AcceptsReturn="True" Height="60" />
                  <Grid ColumnDefinitions="*,150">
                    <TextBlock Classes="dim" VerticalAlignment="Center" Text="Fonte" />
                    <ComboBox Grid.Column="1" x:Name="TextFont" HorizontalAlignment="Stretch" MaxDropDownHeight="360">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                  <Grid ColumnDefinitions="*,150">
                    <TextBlock Classes="dim" VerticalAlignment="Center" Text="Tamanho" />
                    <Slider Grid.Column="1" x:Name="TextSize" Minimum="2" Maximum="20" Value="6" />
                  </Grid>
                  <Grid ColumnDefinitions="*,150">
                    <TextBlock Classes="dim" VerticalAlignment="Center" Text="Alinhamento" />
                    <ComboBox Grid.Column="1" x:Name="TextAlign" HorizontalAlignment="Stretch" SelectedIndex="1">
                      <ComboBoxItem>Esquerda</ComboBoxItem><ComboBoxItem>Centro</ComboBoxItem><ComboBoxItem>Direita</ComboBoxItem>
                    </ComboBox>
                  </Grid>
                  <Grid ColumnDefinitions="*,150">
                    <TextBlock Classes="dim" VerticalAlignment="Center" Text="Posição X" />
                    <Slider Grid.Column="1" x:Name="TextX" Minimum="0" Maximum="100" Value="50" />
                  </Grid>
                  <Grid ColumnDefinitions="*,150">
                    <TextBlock Classes="dim" VerticalAlignment="Center" Text="Posição Y" />
                    <Slider Grid.Column="1" x:Name="TextY" Minimum="0" Maximum="100" Value="50" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CenterTextXButton" Classes="btn" Content="Centro horizontal"
                            ToolTip.Tip="Alinha ao centro e coloca no meio da largura" />
                    <Button x:Name="CenterTextButton" Classes="btn" Content="Centro do quadro"
                            ToolTip.Tip="Alinha ao centro e coloca no meio do quadro" />
                  </StackPanel>
                  <TextBlock Classes="hint" TextWrapping="Wrap"
                             Text="Dica: arraste o texto direto na prévia. Clique duas vezes num controle deslizante para voltar ao valor padrão dele." />
                  <Grid ColumnDefinitions="*,90">
                    <TextBlock Classes="dim" VerticalAlignment="Center" Text="Continua em (slides)" />
                    <ComboBox Grid.Column="1" x:Name="TextSpan" HorizontalAlignment="Stretch" SelectedIndex="0">
                      <ComboBoxItem>1</ComboBoxItem><ComboBoxItem>2</ComboBoxItem><ComboBoxItem>3</ComboBoxItem>
                    </ComboBox>
                  </Grid>
                  <TextBlock Classes="h" Text="ANIMAÇÃO DO TEXTO" />
                  <Grid ColumnDefinitions="*,120">
                    <TextBlock Classes="dim" VerticalAlignment="Center" Text="Efeito" />
                    <ComboBox Grid.Column="1" x:Name="TextAnim" HorizontalAlignment="Stretch" SelectedIndex="1">
                      <ComboBoxItem>Nenhum (sempre visível)</ComboBoxItem><ComboBoxItem>Fade</ComboBoxItem>
                    </ComboBox>
                  </Grid>
                  <StackPanel x:Name="TextAnimFields" Spacing="10">
                    <Grid ColumnDefinitions="*,120">
                      <TextBlock Classes="dim" VerticalAlignment="Center" Text="Aparece após (s)" />
                      <NumericUpDown Grid.Column="1" x:Name="TextDelay" Minimum="0" Maximum="120" Increment="0.1" FormatString="0.0" Value="0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,120">
                      <TextBlock Classes="dim" VerticalAlignment="Center" Text="Fade de entrada (s)" />
                      <NumericUpDown Grid.Column="1" x:Name="TextFadeIn" Minimum="0" Maximum="30" Increment="0.1" FormatString="0.0" Value="0.8" />
                    </Grid>
                    <Grid ColumnDefinitions="*,120">
                      <TextBlock Classes="dim" VerticalAlignment="Center" Text="Fica visível por (s)" />
                      <NumericUpDown Grid.Column="1" x:Name="TextHold" Minimum="0" Maximum="600" Increment="0.5" FormatString="0.0" Value="0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,120">
                      <TextBlock Classes="dim" VerticalAlignment="Center" Text="Fade de saída (s)" />
                      <NumericUpDown Grid.Column="1" x:Name="TextFadeOut" Minimum="0" Maximum="30" Increment="0.1" FormatString="0.0" Value="0.8" />
                    </Grid>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Visível por 0 = até o fim do slide (ou da faixa de slides). A animação aparece ao tocar a prévia (Espaço) e no vídeo; a prévia parada mostra o texto inteiro." />
                  </StackPanel>
                  <Button x:Name="TextStyleDefaultButton" Classes="btn" Content="Usar este estilo como padrão dos novos textos"
                          ToolTip.Tip="Guarda fonte, tamanho, cor, alinhamento, sombra e animação deste texto" />
                  <TextBlock x:Name="TextStyleStatus" Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

              <!-- aba Padrão -->
              <StackPanel x:Name="PaneDefault" Spacing="12" IsVisible="False">
                <TextBlock Classes="h" Text="PARA TODAS AS FOTOS" />
                <WrapPanel x:Name="DefaultEffectChips" />
                <Grid ColumnDefinitions="*,150">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Intensidade" />
                  <Slider Grid.Column="1" x:Name="DefaultIntensity" Minimum="1" Maximum="30" Value="15" />
                </Grid>
                <TextBlock Classes="h" Text="TRANSIÇÃO" />
                <WrapPanel x:Name="DefaultTransitionChips" />
                <TextBlock Classes="h" Text="TAMANHO DA FOTO E FUNDO" />
                <Grid ColumnDefinitions="*,40,120">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Tamanho da foto" />
                  <TextBlock Grid.Column="1" x:Name="DefaultScaleValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" Text="100%" />
                  <Slider Grid.Column="2" x:Name="DefaultScale" Minimum="30" Maximum="100" Value="100" />
                </Grid>
                <WrapPanel x:Name="DefaultBackgroundChips" />
                <TextBlock Classes="dim" Text="Cor do fundo (quando o fundo é Cor)" />
                <WrapPanel x:Name="ColorSwatches" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border x:Name="ColorPreview" Width="24" Height="24" CornerRadius="4" BorderBrush="#55555B" BorderThickness="1" Background="#FFFFFF" />
                  <TextBox x:Name="BackgroundColorBox" Width="110" MaxLength="7" PlaceholderText="#RRGGBB" />
                  <Button Classes="btn" Content="Mais cores…">
                    <Button.Flyout>
                      <Flyout Placement="Left">
                        <ColorView x:Name="BackgroundColorView" Width="320" IsAlphaVisible="False" IsAlphaEnabled="False"
                                   IsColorSpectrumVisible="True" IsColorPaletteVisible="True"
                                   IsColorComponentsVisible="True" IsHexInputVisible="True" />
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
                <Grid ColumnDefinitions="*,40,120">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Sombra da foto" />
                  <TextBlock Grid.Column="1" x:Name="DefaultShadowValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" Text="50%" />
                  <Slider Grid.Column="2" x:Name="DefaultShadow" Minimum="0" Maximum="100" Value="50" />
                </Grid>
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="Abaixo de 100% a foto encolhe e sobra borda, preenchida pela mesma foto desfocada ou por preto. Vale para todas as fotos, exceto as que você ajustar na aba Slide." />
                <TextBlock Classes="h" Text="RITMO" />
                <Grid ColumnDefinitions="*,140">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Com música" />
                  <ComboBox Grid.Column="1" x:Name="BeatsBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem>Automático</ComboBoxItem><ComboBoxItem>A cada 2 batidas</ComboBoxItem>
                    <ComboBoxItem>A cada 4 batidas</ComboBoxItem><ComboBoxItem>A cada 8 batidas</ComboBoxItem>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,140">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Sem música (telão)" />
                  <ComboBox Grid.Column="1" x:Name="SecondsBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem>Pelas batidas (BPM)</ComboBoxItem><ComboBoxItem>Segundos por foto</ComboBoxItem>
                  </ComboBox>
                </Grid>
                <TextBlock x:Name="SecondsWarning" Foreground="#E8A33A" TextWrapping="Wrap" IsVisible="False"
                           Text="Há música neste projeto, então os segundos por foto não são usados: as trocas seguem as batidas. Para usar segundos fixos, clique em Remover música." />
                <Grid x:Name="SecondsRow" ColumnDefinitions="*,140" IsVisible="False">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Segundos por foto" />
                  <NumericUpDown Grid.Column="1" x:Name="SecondsValue" Minimum="0.5" Maximum="120" Increment="0.5"
                                 FormatString="0.##" Value="5" HorizontalAlignment="Stretch" />
                </Grid>
                <TextBlock Classes="h" Text="MÚSICA" />
                <ComboBox x:Name="MusicModeBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                  <ComboBoxItem>Ajustar os slides à música (usa a música toda)</ComboBoxItem>
                  <ComboBoxItem>Cortar a música onde os slides acabam</ComboBoxItem>
                </ComboBox>
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="No primeiro modo as fotos se espalham pela música inteira (com ritmo Automático). No segundo, o vídeo dura o que as fotos pedem e a música é cortada no fim." />
                <Grid ColumnDefinitions="*,40,120">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Entrada gradual (fade-in)" />
                  <TextBlock Grid.Column="1" x:Name="FadeInValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0 s" />
                  <Slider Grid.Column="2" x:Name="FadeInSlider" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="0" />
                </Grid>
                <Grid ColumnDefinitions="*,40,120">
                  <TextBlock Classes="dim" VerticalAlignment="Center" Text="Saída gradual (fade-out)" />
                  <TextBlock Grid.Column="1" x:Name="FadeOutValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1,5 s" />
                  <Slider Grid.Column="2" x:Name="FadeOutSlider" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="1.5" />
                </Grid>
              </StackPanel>

              <!-- aba Exportar -->
              <StackPanel x:Name="PaneExport" Spacing="12" IsVisible="False">
                <TextBlock Classes="h" Text="SAÍDA" />
                <TextBlock x:Name="ExportSummary" Classes="dim" TextWrapping="Wrap" Text="Formato 16:9 (1920×1080)." />
                <TextBlock Classes="h" Text="FORMATO DESTE VÍDEO" />
                <WrapPanel x:Name="ExportFormatChips" />
                <TextBlock Classes="h" Text="RESOLUÇÃO DESTE VÍDEO" />
                <WrapPanel x:Name="ExportResolutionChips" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="Começa igual ao projeto, mas você pode exportar em outro formato ou resolução (ex.: um projeto em 4K também em 1080p) sem alterar o projeto." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="ExportButton2" Classes="btn primary" Content="Exportar vídeo…" />
                  <Button x:Name="CancelExportButton" Classes="btn" Content="Cancelar exportação" IsVisible="False" />
                </StackPanel>
                <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Value="0" IsVisible="False" />
                <TextBlock x:Name="ExportStatus" Classes="hint" TextWrapping="Wrap" />
                <TextBlock Classes="hint" TextWrapping="Wrap" Text="Renderização local. Nenhuma foto sai do computador." />
              </StackPanel>

            </Panel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- linha do tempo -->
    <Border Grid.Row="2" Background="#1F1F22" BorderBrush="#333338" BorderThickness="0,1,0,0" Padding="12,8,12,12">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <TextBlock FontWeight="Medium" Text="Linha do tempo" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="TimelineInfo" Classes="hint" VerticalAlignment="Center" Text="" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button x:Name="MoveLeftButton" Classes="btn" Padding="8,3" Content="◀" ToolTip.Tip="Mover para antes" />
            <Button x:Name="MoveRightButton" Classes="btn" Padding="8,3" Content="▶" ToolTip.Tip="Mover para depois" />
            <Button x:Name="SelectAllButton" Classes="btn" Padding="10,3" Content="Selecionar todas"
                    ToolTip.Tip="Ctrl+clique ou Shift+clique também selecionam várias" />
            <Button x:Name="RemovePhotoButton" Classes="btn" Padding="10,3" Content="Remover foto"
                    ToolTip.Tip="Tira do projeto (o arquivo não é apagado). Atalho: Delete" />
            <Button x:Name="AddPhotosButton" Classes="btn" Padding="10,3" Content="+ Fotos"
                    ToolTip.Tip="Incluir fotos (também dá para arrastar do Explorador)" />
          </StackPanel>
        </Grid>
        <Grid>
        <ListBox x:Name="SlideList" Height="132" Background="Transparent" SelectionMode="Multiple"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Width="150" Height="104" Background="#2A2A30">
                <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                <Border Background="#99000000" VerticalAlignment="Bottom" Padding="6,3">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Tags}" FontSize="10" Foreground="#E8A33A" />
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Canvas IsHitTestVisible="False">
          <Border x:Name="DropMarker" Width="3" Height="104" Background="#3B8BFF" CornerRadius="2" IsVisible="False" Canvas.Top="4" />
        </Canvas>
        </Grid>
      </StackPanel>
    </Border>
    <!-- novo projeto (cobre tudo) -->
    <Border x:Name="NewProjectView" Grid.Row="1" Grid.RowSpan="2" Background="#161618" Padding="40,28" IsVisible="False">
      <StackPanel MaxWidth="560" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Top">
        <TextBlock Text="Novo projeto" FontSize="22" FontWeight="Medium" />
        <TextBlock Classes="h" Text="NOME" />
        <TextBox x:Name="NewName" PlaceholderText="Ex.: Isadora e Lucas" />
        <TextBlock Classes="h" Text="PRESET" />
        <ComboBox x:Name="NewPresetBox" HorizontalAlignment="Stretch" />
        <TextBlock Classes="hint" TextWrapping="Wrap" Text="O preset define efeitos, fundo, música e estilo dos textos. O formato e a resolução abaixo começam pelos dele, mas você pode mudar." />
        <TextBlock Classes="h" Text="FORMATO" />
        <WrapPanel x:Name="NewFormatChips" />
        <TextBlock Classes="h" Text="RESOLUÇÃO" />
        <WrapPanel x:Name="NewResolutionChips" />
        <TextBlock x:Name="NewSizeInfo" Classes="hint" />
        <TextBlock Classes="h" Text="PASTA DO PROJETO" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="NewProjectFolderButton" Classes="btn" Content="Escolher pasta do projeto…" />
          <TextBlock x:Name="NewProjectFolderText" Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
        </StackPanel>
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="O arquivo do projeto (.slyden) é gravado aqui, e o vídeo exportado sugere esta pasta. Sem escolher, fica na pasta do programa." />
        <TextBlock Classes="h" Text="FOTOS" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="NewFolderButton" Classes="btn" Content="Escolher pasta de fotos…" />
          <TextBlock x:Name="NewFolderText" Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" Text="Nenhuma pasta escolhida" />
        </StackPanel>
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="A pasta é opcional: depois você também pode arrastar fotos para o projeto ou usar + Fotos." />
        <TextBlock x:Name="NewMessage" Foreground="#E8A33A" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button x:Name="NewCreateButton" Classes="btn primary" Content="Criar projeto" />
          <Button x:Name="NewCancelButton" Classes="btn" Content="Cancelar" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- tela de projetos (cobre o editor) -->
    <Border x:Name="HomeView" Grid.Row="1" Grid.RowSpan="2" Background="#161618" Padding="40,28">
      <Grid RowDefinitions="Auto,Auto,*" MaxWidth="1400">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Spacing="4">
            <TextBlock Text="Projetos" FontSize="22" FontWeight="Medium" />
            <TextBlock Classes="hint" Text="Escolha um projeto para continuar ou crie um novo a partir de uma pasta de fotos." />
            <TextBlock x:Name="HomeMessage" Foreground="#E8A33A" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="NewProjectButton" Classes="btn primary" Content="Novo projeto" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
          <TextBox x:Name="HomeSearch" Width="280" PlaceholderText="Buscar projeto…" />
          <ComboBox x:Name="HomeSort" Width="190" SelectedIndex="0">
            <ComboBoxItem Content="Mais recentes" />
            <ComboBoxItem Content="Nome (A–Z)" />
          </ComboBox>
        </StackPanel>
        <Grid Grid.Row="2">
          <ListBox x:Name="ProjectList" Background="Transparent" SelectionMode="Single">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.DataTemplates>
              <DataTemplate DataType="local:NewProjectCard">
                <Button Width="280" Height="295" VerticalAlignment="Top" Classes="btn" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="OnNewCardClick" BorderBrush="#55555B">
                  <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="44" HorizontalAlignment="Center" Foreground="#3B8BFF" />
                    <TextBlock Text="Novo projeto" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
              <DataTemplate DataType="local:ProjectItem">
                <Border Width="280" Background="#1F1F22" BorderBrush="#333338" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                  <StackPanel>
                    <Border Height="158" Background="#0F0F10">
                      <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="12,10,12,12" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Details}" Classes="hint" />
                      <TextBlock Text="{Binding Edited}" Classes="hint" />
                      <TextBlock Text="{Binding Folder}" Classes="hint" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                        <Button Classes="btn primary" Content="Abrir" Tag="open" Click="OnProjectAction" />
                        <Button Classes="btn" Content="Duplicar" Tag="duplicate" Click="OnProjectAction" />
                        <Button Classes="btn" Content="{Binding DeleteLabel}" Tag="delete" Click="OnProjectAction" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
          <TextBlock x:Name="NoProjects" Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                     Text="Nenhum projeto ainda. Clique em Novo projeto." />
        </Grid>
      </Grid>    </Border>

    <!-- configurações do programa (valem para todos os projetos; cobrem tudo) -->
    <Border x:Name="SettingsView" Grid.Row="1" Grid.RowSpan="2" Background="#161618" IsVisible="False">
      <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Margin="40,28,40,40" HorizontalAlignment="Center">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="Configurações" FontSize="22" FontWeight="Medium" />
              <TextBlock Classes="hint" TextWrapping="Wrap"
                         Text="Valem para o programa, fora dos projetos. As mudanças são salvas na hora e afetam só projetos e textos NOVOS." />
            </StackPanel>
            <Button Grid.Column="1" x:Name="SettingsCloseButton" Classes="btn primary" Content="Voltar" VerticalAlignment="Center" />
          </Grid>

          <TextBlock Classes="h" Margin="0,10,0,0" Text="PRESETS" />
          <TextBlock Classes="hint" TextWrapping="Wrap"
                     Text="Um preset é um conjunto de ajustes para um tipo de trabalho (ex.: Casamento, Clientes, Telão). Escolha o preset ao criar um projeto. Tudo abaixo vale para o preset selecionado." />
          <ComboBox x:Name="StPresetBox" HorizontalAlignment="Stretch" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PresetNewButton" Classes="btn" Content="Novo" ToolTip.Tip="Novo preset com os ajustes de fábrica" />
            <Button x:Name="PresetDuplicateButton" Classes="btn" Content="Duplicar" />
            <Button x:Name="PresetFromProjectButton" Classes="btn" Content="Novo a partir do projeto aberto" />
            <Button x:Name="PresetDeleteButton" Classes="btn" Content="Excluir" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="StPresetName" Width="220" PlaceholderText="Nome do preset" />
            <Button x:Name="PresetRenameButton" Classes="btn" Content="Renomear" />
            <ToggleButton x:Name="PresetDefaultButton" Classes="chip" Content="★ Padrão para novos projetos" />
          </StackPanel>

          <TextBlock Classes="h" Margin="0,10,0,0" Text="PRESET: VÍDEO" />
          <TextBlock Classes="dim" Text="Formato" />
          <WrapPanel x:Name="StFormatChips" />
          <TextBlock Classes="dim" Text="Resolução" />
          <WrapPanel x:Name="StResolutionChips" />

          <TextBlock Classes="h" Margin="0,10,0,0" Text="PRESET: MOVIMENTO" />
          <TextBlock Classes="dim" Text="Efeitos (vários = alternam)" />
          <WrapPanel x:Name="StEffectChips" />
          <Grid ColumnDefinitions="*,50,180">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Intensidade" />
            <TextBlock Grid.Column="1" x:Name="StIntensityValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <Slider Grid.Column="2" x:Name="StIntensity" Minimum="1" Maximum="30" />
          </Grid>
          <TextBlock Classes="dim" Text="Transição" />
          <WrapPanel x:Name="StTransitionChips" />

          <TextBlock Classes="h" Margin="0,10,0,0" Text="PRESET: FOTO E FUNDO" />
          <Grid ColumnDefinitions="*,50,180">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Tamanho da foto" />
            <TextBlock Grid.Column="1" x:Name="StScaleValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <Slider Grid.Column="2" x:Name="StScale" Minimum="30" Maximum="100" />
          </Grid>
          <WrapPanel x:Name="StBackgroundChips" />
          <TextBlock Classes="dim" Text="Cor do fundo (quando o fundo é Cor)" />
          <WrapPanel x:Name="StSwatches" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border x:Name="StColorPreview" Width="24" Height="24" CornerRadius="4" BorderBrush="#55555B" BorderThickness="1" />
            <TextBox x:Name="StColorBox" Width="110" MaxLength="7" PlaceholderText="#RRGGBB" />
          </StackPanel>
          <Grid ColumnDefinitions="*,50,180">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Sombra da foto" />
            <TextBlock Grid.Column="1" x:Name="StShadowValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <Slider Grid.Column="2" x:Name="StShadow" Minimum="0" Maximum="100" />
          </Grid>

          <TextBlock Classes="h" Margin="0,10,0,0" Text="PRESET: MÚSICA" />
          <ComboBox x:Name="StMusicMode" HorizontalAlignment="Stretch">
            <ComboBoxItem>Ajustar os slides à música (usa a música toda)</ComboBoxItem>
            <ComboBoxItem>Cortar a música onde os slides acabam</ComboBoxItem>
          </ComboBox>
          <Grid ColumnDefinitions="*,50,180">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Entrada gradual (fade-in)" />
            <TextBlock Grid.Column="1" x:Name="StFadeInValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <Slider Grid.Column="2" x:Name="StFadeIn" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" />
          </Grid>
          <Grid ColumnDefinitions="*,50,180">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Saída gradual (fade-out)" />
            <TextBlock Grid.Column="1" x:Name="StFadeOutValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <Slider Grid.Column="2" x:Name="StFadeOut" Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" />
          </Grid>

          <TextBlock Classes="h" Margin="0,10,0,0" Text="PRESET: TEXTOS NOVOS (CAPA E LEGENDAS)" />
          <Grid ColumnDefinitions="*,260">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Fonte padrão" />
            <ComboBox Grid.Column="1" x:Name="StTextFont" HorizontalAlignment="Stretch" MaxDropDownHeight="360">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,50,180">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Tamanho" />
            <TextBlock Grid.Column="1" x:Name="StTextSizeValue" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <Slider Grid.Column="2" x:Name="StTextSize" Minimum="2" Maximum="20" />
          </Grid>
          <Grid ColumnDefinitions="*,260">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Cor do texto" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Border x:Name="StTextColorPreview" Width="24" Height="24" CornerRadius="4" BorderBrush="#55555B" BorderThickness="1" />
              <TextBox x:Name="StTextColor" Width="110" MaxLength="7" PlaceholderText="#RRGGBB" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleButton x:Name="StTextBold" Classes="chip" Content="Negrito" />
            <ToggleButton x:Name="StTextItalic" Classes="chip" Content="Itálico" />
            <ToggleButton x:Name="StTextShadow" Classes="chip" Content="Sombra" />
          </StackPanel>
          <Grid ColumnDefinitions="*,260">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Alinhamento" />
            <ComboBox Grid.Column="1" x:Name="StTextAlign" HorizontalAlignment="Stretch">
              <ComboBoxItem>Esquerda</ComboBoxItem><ComboBoxItem>Centro</ComboBoxItem><ComboBoxItem>Direita</ComboBoxItem>
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,120">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Fade de entrada (s)" />
            <NumericUpDown Grid.Column="1" x:Name="StTextFadeIn" Minimum="0" Maximum="30" Increment="0.1" FormatString="0.0" />
          </Grid>
          <Grid ColumnDefinitions="*,120">
            <TextBlock Classes="dim" VerticalAlignment="Center" Text="Fade de saída (s)" />
            <NumericUpDown Grid.Column="1" x:Name="StTextFadeOut" Minimum="0" Maximum="30" Increment="0.1" FormatString="0.0" />
          </Grid>

          <TextBlock Classes="h" Margin="0,10,0,0" Text="PADRÕES" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CopyFromProjectButton" Classes="btn" Content="Copiar ajustes do projeto aberto para este preset" />
            <Button x:Name="ResetDefaultsButton" Classes="btn" Content="Restaurar este preset ao de fábrica" />
          </StackPanel>
          <TextBlock x:Name="DefaultsStatus" Classes="hint" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>

