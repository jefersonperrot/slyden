<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Slyden.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#161618" />
      <Setter Property="Foreground" Value="#E6E6E8" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- botões comuns -->
    <Style Selector="Button.btn">
      <Setter Property="Background" Value="#26262A" />
      <Setter Property="BorderBrush" Value="#44444A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style Selector="Button.btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#303036" />
      <Setter Property="BorderBrush" Value="#6F6F77" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3B8BFF" />
      <Setter Property="BorderBrush" Value="#3B8BFF" />
      <Setter Property="Foreground" Value="#06101E" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#5BA0FF" />
      <Setter Property="Foreground" Value="#06101E" />
    </Style>

    <!-- chips e segmentos (ToggleButton) -->
    <Style Selector="ToggleButton.chip">
      <Setter Property="Background" Value="#26262A" />
      <Setter Property="BorderBrush" Value="#44444A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Foreground" Value="#A4A4AB" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#17304F" />
      <Setter Property="BorderBrush" Value="#3B8BFF" />
      <Setter Property="Foreground" Value="#BCD8FF" />
    </Style>
    <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1D3A60" />
      <Setter Property="Foreground" Value="#BCD8FF" />
    </Style>
    <Style Selector="ToggleButton.seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Foreground" Value="#A4A4AB" />
    </Style>
    <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#17304F" />
      <Setter Property="Foreground" Value="#BCD8FF" />
    </Style>

    <!-- abas -->
    <Style Selector="ToggleButton.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,10" />
      <Setter Property="Foreground" Value="#A4A4AB" />
    </Style>
    <Style Selector="ToggleButton.tab:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#3B8BFF" />
      <Setter Property="Foreground" Value="#E6E6E8" />
    </Style>

    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="#6F6F77" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#A4A4AB" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#6F6F77" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ListBox#SlideList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#SlideList ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#3B8BFF" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#SlideList ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
